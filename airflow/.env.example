# Airflow showcase env -- copy to .env (never commit .env). Used by
# docker-compose.airflow.yml and `airflow standalone`.

# --- Airflow core ---------------------------------------------------------- #
# SequentialExecutor is REQUIRED with the SQLite metadata DB (Airflow refuses
# LocalExecutor on SQLite). Fine for this single-node screenshot showcase.
AIRFLOW__CORE__EXECUTOR=SequentialExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
# UID for file ownership in the container (Linux). 50000 is the airflow image uid.
AIRFLOW_UID=50000

# --- Repo anchor (mirrors the Airflow Variables; set whichever you prefer) -- #
# Inside the container the repo is mounted at /opt/flight (see compose).
FLIGHT_REPO_ROOT=/opt/flight
LAKE_ROOT=/opt/flight/data/lake
DUCKDB_PATH=/opt/flight/data/lake/gold.duckdb
# Comma list of years for ingest/train (mirrors contract BRONZE/TRAIN years).
FLIGHT_TRAIN_YEARS=2022,2023,2024,2025
# Min ROC-AUC for the retrain quality gate to publish.
FLIGHT_ROC_AUC_GATE=0.55

# --- Object storage for publish_artifacts.py (leave blank => no-op) -------- #
# When all three of ENDPOINT/BUCKET/ACCESS_KEY_ID are set, publish uploads the
# bundle + gold.duckdb to {S3_PREFIX}/ where the serving layer pulls them.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=artifacts/latest
S3_REGION=us-east-1

# --- MLflow (retrain register step; blank => local file store) ------------- #
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=flight_delay
MLFLOW_MODEL_NAME=flight_delay_lgbm
